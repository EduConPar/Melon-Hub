<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de música (MusicWidget). Sin updatePeriodMillis: se repinta
     cuando cambia la canción o se toca algo, no a intervalos. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_w98_player"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="150dp"
    android:previewLayout="@layout/widget_w98_player"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
