<?xml version="1.0" encoding="utf-8"?>
<!-- Botón Win98: en relieve y, pulsado, hundido (como button:active de 98.css). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><layer-list>
    <item><shape><solid android:color="#ffffff" /></shape></item>
    <item android:right="1dp" android:bottom="1dp"><shape><solid android:color="#0a0a0a" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="#dfdfdf" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="#808080" /></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="#c0c0c0" /></shape></item>
    </layer-list></item>
    <item><layer-list>
    <item><shape><solid android:color="#0a0a0a" /></shape></item>
    <item android:right="1dp" android:bottom="1dp"><shape><solid android:color="#ffffff" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="#808080" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="#dfdfdf" /></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="#c0c0c0" /></shape></item>
    </layer-list></item>
</selector>
