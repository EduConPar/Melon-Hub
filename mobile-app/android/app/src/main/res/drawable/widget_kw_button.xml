<?xml version="1.0" encoding="utf-8"?>
<!-- Botón Kawaii: liso con borde de 2 px; pulsado, active-rose. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FCE7F5" />
            <stroke android:width="2dp" android:color="#49388B" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#F0E8F3" />
            <stroke android:width="2dp" android:color="#49388B" />
        </shape>
    </item>
</selector>
