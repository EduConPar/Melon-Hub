<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de "Mis playlists" (Win98). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_w98_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:src="@drawable/widget_ic_note"
        android:tint="@color/widget_w98_item_text" />

    <TextView
        android:id="@+id/w_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="@font/ms_sans_serif"
        android:singleLine="true"
        android:textColor="@color/widget_w98_item_text"
        android:textSize="13sp" />
</LinearLayout>
