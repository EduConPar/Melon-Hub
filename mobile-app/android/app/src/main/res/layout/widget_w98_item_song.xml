<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de canción de una playlist (Win98).
     Generado (mismos ids en las dos interfaces). Los colores son los
     de la interfaz sin tema; PlayerWidget pone los del tema del usuario.
     Los textos son imágenes (WidgetText): los widgets no cargan fuentes
     de la app. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingTop="3dp"
    android:paddingRight="5dp"
    android:paddingBottom="3dp">
    <ImageView
        android:id="@+id/w_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:scaleType="fitStart" />
    <ImageView
        android:id="@+id/w_item_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:scaleType="fitStart" />
</LinearLayout>
