<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de canción de una playlist (Win98): título y, debajo, artista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_w98_item"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/w_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="@font/ms_sans_serif"
        android:singleLine="true"
        android:textColor="@color/widget_w98_item_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_item_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="@font/ms_sans_serif"
        android:singleLine="true"
        android:textColor="@color/widget_w98_item_sub"
        android:textSize="11sp" />
</LinearLayout>
