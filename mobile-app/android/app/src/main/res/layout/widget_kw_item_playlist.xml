<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de "Mis playlists" (Kawaii).
     Generado (mismos ids en las dos interfaces). Los colores son los
     de la interfaz sin tema; MusicWidget pone los del tema del usuario.
     Los textos son imágenes (WidgetText): los widgets no cargan fuentes
     de la app. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="5dp"
    android:paddingTop="4dp"
    android:paddingRight="5dp"
    android:paddingBottom="4dp">
    <ImageView
        android:id="@+id/w_item_ic"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_ic_note"
        android:tint="#472CC7" />
    <ImageView
        android:id="@+id/w_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="5dp"
        android:contentDescription="@null"
        android:scaleType="fitStart" />
</LinearLayout>
