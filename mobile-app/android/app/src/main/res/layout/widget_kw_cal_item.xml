<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de Próximos (Kawaii).
     Generado (mismos ids en las dos interfaces). Los colores son los
     de la interfaz sin tema; MusicWidget pone los del tema del usuario.
     Los textos son imágenes (WidgetText): los widgets no cargan fuentes
     de la app. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="4dp"
    android:paddingRight="5dp"
    android:paddingBottom="4dp">
    <LinearLayout
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/w_ag_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/w_ag_mon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="5dp"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/w_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="fitStart" />
        <ImageView
            android:id="@+id/w_item_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="fitStart" />
    </LinearLayout>
    <ImageView
        android:id="@+id/w_ag_kind"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginLeft="4dp"
        android:contentDescription="@null" />
</LinearLayout>
