<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de calendario 2×2: Próximos (recordatorios y eventos) (Kawaii).
     Generado (mismos ids en las dos interfaces). Los colores son los
     de la interfaz sin tema; MusicWidget pone los del tema del usuario.
     Los textos son imágenes (WidgetText): los widgets no cargan fuentes
     de la app. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_win_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#49388B"
    android:padding="2dp">
    <LinearLayout
        android:id="@+id/w_win"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0D4E7"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/w_tb_1"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:background="#49388B"
            android:padding="2dp">
            <LinearLayout
                android:id="@+id/w_tb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0E8F3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="5dp"
                android:paddingRight="1dp">
                <ImageView
                    android:id="@+id/w_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:contentDescription="@null"
                    android:scaleType="fitStart" />
                <FrameLayout
                    android:id="@+id/w_menu_1"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/cal_open"
                    android:background="#49388B"
                    android:padding="2dp">
                    <FrameLayout
                        android:id="@+id/w_menu"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F0E8F3">
                        <ImageView
                            android:id="@+id/w_menu_ic"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="3dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_ic_menu"
                            android:tint="#472CC7" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_body_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="#49388B"
            android:padding="2dp">
            <LinearLayout
                android:id="@+id/w_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0E8F3"
                android:orientation="vertical"
                android:padding="4dp">
                <FrameLayout
                    android:id="@+id/w_lst_1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#49388B"
                    android:padding="2dp">
                    <FrameLayout
                        android:id="@+id/w_lst"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF"
                        android:padding="0dp">
                        <ListView
                            android:id="@+id/w_list"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:divider="@null"
                            android:dividerHeight="0dp" />
                        <ImageView
                            android:id="@+id/w_empty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:scaleType="centerInside" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
