<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de música 2×2, pantalla del reproductor (Kawaii).
     Generado (mismos ids en las dos interfaces). Los colores son los
     de la interfaz sin tema; MusicWidget pone los del tema del usuario.
     Los textos son imágenes (WidgetText): los widgets no cargan fuentes
     de la app. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_win_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#49388B"
    android:padding="2dp">
    <LinearLayout
        android:id="@+id/w_win"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0D4E7"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/w_tb_1"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:background="#49388B"
            android:padding="2dp">
            <LinearLayout
                android:id="@+id/w_tb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0E8F3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="5dp"
                android:paddingRight="1dp">
                <ImageView
                    android:id="@+id/w_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingLeft="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitStart" />
                <FrameLayout
                    android:id="@+id/w_shuf_1"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginRight="2dp"
                    android:contentDescription="@string/widget_shuffle"
                    android:background="#49388B"
                    android:padding="2dp">
                    <FrameLayout
                        android:id="@+id/w_shuf"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F0E8F3">
                        <ImageView
                            android:id="@+id/w_shuf_ic"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="2dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_ic_shuffle"
                            android:tint="#472CC7" />
                    </FrameLayout>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/w_menu_1"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/widget_playlists"
                    android:background="#49388B"
                    android:padding="2dp">
                    <FrameLayout
                        android:id="@+id/w_menu"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F0E8F3">
                        <ImageView
                            android:id="@+id/w_menu_ic"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="3dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_ic_menu"
                            android:tint="#472CC7" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_body_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="#49388B"
            android:padding="2dp">
            <LinearLayout
                android:id="@+id/w_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0E8F3"
                android:orientation="vertical"
                android:padding="4dp"
                android:gravity="center_horizontal">
                <FrameLayout
                    android:id="@+id/w_cov_1"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#49388B"
                    android:padding="2dp">
                    <FrameLayout
                        android:id="@+id/w_cov"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF">
                        <ImageView
                            android:id="@+id/w_cover_ph"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_cover_note"
                            android:tint="#FF66B2" />
                        <ImageView
                            android:id="@+id/w_cover"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/widget_cover"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>
                <ImageView
                    android:id="@+id/w_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside" />
                <FrameLayout
                    android:id="@+id/w_prog_1"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="3dp"
                    android:background="#49388B"
                    android:padding="2dp">
                    <FrameLayout
                        android:id="@+id/w_prog"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF"
                        android:paddingLeft="1dp"
                        android:paddingRight="1dp">
                        <ImageView
                            android:id="@+id/w_prog_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY" />
                    </FrameLayout>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:id="@+id/w_prev_1"
                        android:layout_width="32dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="3dp"
                        android:contentDescription="@string/widget_prev"
                        android:background="#49388B"
                        android:padding="2dp">
                        <FrameLayout
                            android:id="@+id/w_prev"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#F0E8F3">
                            <ImageView
                                android:id="@+id/w_prev_ic"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/widget_ic_prev"
                                android:tint="#472CC7" />
                        </FrameLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/w_play_1"
                        android:layout_width="32dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="3dp"
                        android:contentDescription="@string/widget_toggle"
                        android:background="#49388B"
                        android:padding="2dp">
                        <FrameLayout
                            android:id="@+id/w_play"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#F0E8F3">
                            <ImageView
                                android:id="@+id/w_play_ic"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/widget_ic_play"
                                android:tint="#472CC7" />
                        </FrameLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/w_next_1"
                        android:layout_width="32dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/widget_next"
                        android:background="#49388B"
                        android:padding="2dp">
                        <FrameLayout
                            android:id="@+id/w_next"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#F0E8F3">
                            <ImageView
                                android:id="@+id/w_next_ic"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/widget_ic_next"
                                android:tint="#472CC7" />
                        </FrameLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
