<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de música 2×2, pantalla del reproductor (Win98).
     Generado (mismos ids en las dos interfaces). Los colores son los
     de la interfaz sin tema; MusicWidget pone los del tema del usuario.
     Los textos son imágenes (WidgetText): los widgets no cargan fuentes
     de la app. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_win_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:paddingRight="1dp"
    android:paddingBottom="1dp">
    <FrameLayout
        android:id="@+id/w_win_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DFDFDF"
        android:paddingLeft="1dp"
        android:paddingTop="1dp">
        <FrameLayout
            android:id="@+id/w_win_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#808080"
            android:paddingRight="1dp"
            android:paddingBottom="1dp">
            <FrameLayout
                android:id="@+id/w_win_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:paddingLeft="1dp"
                android:paddingTop="1dp">
                <LinearLayout
                    android:id="@+id/w_win"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#C0C0C0"
                    android:orientation="vertical"
                    android:padding="1dp">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp">
                        <ImageView
                            android:id="@+id/w_tb_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_w98_titlebar" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp">
                            <ImageView
                                android:id="@+id/w_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingLeft="2dp"
                                android:contentDescription="@null"
                                android:scaleType="fitStart"
                                android:src="@drawable/widget_preview_title" />
                            <FrameLayout
                                android:id="@+id/w_shuf_1"
                                android:layout_width="18dp"
                                android:layout_height="16dp"
                                android:layout_marginRight="2dp"
                                android:contentDescription="@string/widget_shuffle"
                                android:background="#0A0A0A"
                                android:paddingRight="1dp"
                                android:paddingBottom="1dp">
                                <FrameLayout
                                    android:id="@+id/w_shuf_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#FFFFFF"
                                    android:paddingLeft="1dp"
                                    android:paddingTop="1dp">
                                    <FrameLayout
                                        android:id="@+id/w_shuf_3"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="#808080"
                                        android:paddingRight="1dp"
                                        android:paddingBottom="1dp">
                                        <FrameLayout
                                            android:id="@+id/w_shuf_4"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="#DFDFDF"
                                            android:paddingLeft="1dp"
                                            android:paddingTop="1dp">
                                            <FrameLayout
                                                android:id="@+id/w_shuf"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:background="#C0C0C0">
                                                <ImageView
                                                    android:id="@+id/w_shuf_ic"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="match_parent"
                                                    android:contentDescription="@null"
                                                    android:padding="2dp"
                                                    android:scaleType="fitCenter"
                                                    android:src="@drawable/widget_ic_shuffle"
                                                    android:tint="#000000" />
                                            </FrameLayout>
                                        </FrameLayout>
                                    </FrameLayout>
                                </FrameLayout>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/w_menu_1"
                                android:layout_width="18dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/widget_playlists"
                                android:background="#0A0A0A"
                                android:paddingRight="1dp"
                                android:paddingBottom="1dp">
                                <FrameLayout
                                    android:id="@+id/w_menu_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#FFFFFF"
                                    android:paddingLeft="1dp"
                                    android:paddingTop="1dp">
                                    <FrameLayout
                                        android:id="@+id/w_menu_3"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="#808080"
                                        android:paddingRight="1dp"
                                        android:paddingBottom="1dp">
                                        <FrameLayout
                                            android:id="@+id/w_menu_4"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="#DFDFDF"
                                            android:paddingLeft="1dp"
                                            android:paddingTop="1dp">
                                            <FrameLayout
                                                android:id="@+id/w_menu"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:background="#C0C0C0">
                                                <ImageView
                                                    android:id="@+id/w_menu_ic"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="match_parent"
                                                    android:contentDescription="@null"
                                                    android:padding="3dp"
                                                    android:scaleType="fitCenter"
                                                    android:src="@drawable/widget_ic_menu"
                                                    android:tint="#000000" />
                                            </FrameLayout>
                                        </FrameLayout>
                                    </FrameLayout>
                                </FrameLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>
                    <LinearLayout
                        android:id="@+id/w_body"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="#C0C0C0"
                        android:orientation="vertical"
                        android:padding="4dp"
                        android:gravity="center_horizontal">
                        <FrameLayout
                            android:id="@+id/w_cov_1"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:paddingRight="1dp"
                            android:paddingBottom="1dp">
                            <FrameLayout
                                android:id="@+id/w_cov_2"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:background="#808080"
                                android:paddingLeft="1dp"
                                android:paddingTop="1dp">
                                <FrameLayout
                                    android:id="@+id/w_cov_3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:background="#DFDFDF"
                                    android:paddingRight="1dp"
                                    android:paddingBottom="1dp">
                                    <FrameLayout
                                        android:id="@+id/w_cov_4"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:background="#0A0A0A"
                                        android:paddingLeft="1dp"
                                        android:paddingTop="1dp">
                                        <FrameLayout
                                            android:id="@+id/w_cov"
                                            android:layout_width="wrap_content"
                                            android:layout_height="match_parent"
                                            android:background="#FFFFFF">
                                            <ImageView
                                                android:id="@+id/w_cover_ph"
                                                android:layout_width="wrap_content"
                                                android:layout_height="match_parent"
                                                android:adjustViewBounds="true"
                                                android:contentDescription="@null"
                                                android:scaleType="fitCenter"
                                                android:src="@drawable/widget_cover_note"
                                                android:tint="#808080" />
                                            <ImageView
                                                android:id="@+id/w_cover"
                                                android:layout_width="wrap_content"
                                                android:layout_height="match_parent"
                                                android:adjustViewBounds="true"
                                                android:contentDescription="@string/widget_cover"
                                                android:scaleType="fitCenter"
                                                android:visibility="gone" />
                                        </FrameLayout>
                                    </FrameLayout>
                                </FrameLayout>
                            </FrameLayout>
                        </FrameLayout>
                        <ImageView
                            android:id="@+id/w_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:contentDescription="@null"
                            android:scaleType="centerInside"
                            android:src="@drawable/widget_preview_idle" />
                        <FrameLayout
                            android:id="@+id/w_prog_1"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="3dp"
                            android:background="#FFFFFF"
                            android:paddingRight="1dp"
                            android:paddingBottom="1dp">
                            <FrameLayout
                                android:id="@+id/w_prog_2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#808080"
                                android:paddingLeft="1dp"
                                android:paddingTop="1dp">
                                <FrameLayout
                                    android:id="@+id/w_prog_3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#DFDFDF"
                                    android:paddingRight="1dp"
                                    android:paddingBottom="1dp">
                                    <FrameLayout
                                        android:id="@+id/w_prog_4"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="#0A0A0A"
                                        android:paddingLeft="1dp"
                                        android:paddingTop="1dp">
                                        <FrameLayout
                                            android:id="@+id/w_prog"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="#FFFFFF">
                                            <ImageView
                                                android:id="@+id/w_prog_img"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:contentDescription="@null"
                                                android:scaleType="fitXY" />
                                        </FrameLayout>
                                    </FrameLayout>
                                </FrameLayout>
                            </FrameLayout>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">
                            <FrameLayout
                                android:id="@+id/w_prev_1"
                                android:layout_width="32dp"
                                android:layout_height="24dp"
                                android:layout_marginRight="3dp"
                                android:contentDescription="@string/widget_prev"
                                android:background="#0A0A0A"
                                android:paddingRight="1dp"
                                android:paddingBottom="1dp">
                                <FrameLayout
                                    android:id="@+id/w_prev_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#FFFFFF"
                                    android:paddingLeft="1dp"
                                    android:paddingTop="1dp">
                                    <FrameLayout
                                        android:id="@+id/w_prev_3"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="#808080"
                                        android:paddingRight="1dp"
                                        android:paddingBottom="1dp">
                                        <FrameLayout
                                            android:id="@+id/w_prev_4"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="#DFDFDF"
                                            android:paddingLeft="1dp"
                                            android:paddingTop="1dp">
                                            <FrameLayout
                                                android:id="@+id/w_prev"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:background="#C0C0C0">
                                                <ImageView
                                                    android:id="@+id/w_prev_ic"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="match_parent"
                                                    android:contentDescription="@null"
                                                    android:padding="6dp"
                                                    android:scaleType="fitCenter"
                                                    android:src="@drawable/widget_ic_prev"
                                                    android:tint="#000000" />
                                            </FrameLayout>
                                        </FrameLayout>
                                    </FrameLayout>
                                </FrameLayout>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/w_play_1"
                                android:layout_width="32dp"
                                android:layout_height="24dp"
                                android:layout_marginRight="3dp"
                                android:contentDescription="@string/widget_toggle"
                                android:background="#0A0A0A"
                                android:paddingRight="1dp"
                                android:paddingBottom="1dp">
                                <FrameLayout
                                    android:id="@+id/w_play_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#FFFFFF"
                                    android:paddingLeft="1dp"
                                    android:paddingTop="1dp">
                                    <FrameLayout
                                        android:id="@+id/w_play_3"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="#808080"
                                        android:paddingRight="1dp"
                                        android:paddingBottom="1dp">
                                        <FrameLayout
                                            android:id="@+id/w_play_4"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="#DFDFDF"
                                            android:paddingLeft="1dp"
                                            android:paddingTop="1dp">
                                            <FrameLayout
                                                android:id="@+id/w_play"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:background="#C0C0C0">
                                                <ImageView
                                                    android:id="@+id/w_play_ic"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="match_parent"
                                                    android:contentDescription="@null"
                                                    android:padding="5dp"
                                                    android:scaleType="fitCenter"
                                                    android:src="@drawable/widget_ic_play"
                                                    android:tint="#000000" />
                                            </FrameLayout>
                                        </FrameLayout>
                                    </FrameLayout>
                                </FrameLayout>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/w_next_1"
                                android:layout_width="32dp"
                                android:layout_height="24dp"
                                android:contentDescription="@string/widget_next"
                                android:background="#0A0A0A"
                                android:paddingRight="1dp"
                                android:paddingBottom="1dp">
                                <FrameLayout
                                    android:id="@+id/w_next_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#FFFFFF"
                                    android:paddingLeft="1dp"
                                    android:paddingTop="1dp">
                                    <FrameLayout
                                        android:id="@+id/w_next_3"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="#808080"
                                        android:paddingRight="1dp"
                                        android:paddingBottom="1dp">
                                        <FrameLayout
                                            android:id="@+id/w_next_4"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="#DFDFDF"
                                            android:paddingLeft="1dp"
                                            android:paddingTop="1dp">
                                            <FrameLayout
                                                android:id="@+id/w_next"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:background="#C0C0C0">
                                                <ImageView
                                                    android:id="@+id/w_next_ic"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="match_parent"
                                                    android:contentDescription="@null"
                                                    android:padding="6dp"
                                                    android:scaleType="fitCenter"
                                                    android:src="@drawable/widget_ic_next"
                                                    android:tint="#000000" />
                                            </FrameLayout>
                                        </FrameLayout>
                                    </FrameLayout>
                                </FrameLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
